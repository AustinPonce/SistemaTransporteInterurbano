@{
    ViewData["Title"] = "Inicio Chofer";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">
        <div class="mb-5">
            <h2 class="text-white fw-bold mb-1">
                <i class="bi bi-grid me-2 text-info"></i>Panel del Chofer
            </h2>
            <p class="text-white-50">Selecciona un módulo para continuar.</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Pasajero" asp-action="Index" class="text-decoration-none">
                    <div class="glass-card p-4">
                        <div class="mb-3">
                            <i class="bi bi-people fs-1 text-info"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Registro de Pasajeros</h5>
                        <p class="text-white-50 small mb-0">Registrar y administrar pasajeros del sistema.</p>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Ruta" asp-action="Index" class="text-decoration-none">
                    <div class="glass-card p-4">
                        <div class="mb-3">
                            <i class="bi bi-signpost-2 fs-1 text-info"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Catálogo de Rutas</h5>
                        <p class="text-white-50 small mb-0">Gestionar las rutas disponibles del sistema.</p>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Unidad" asp-action="Index" class="text-decoration-none">
                    <div class="glass-card p-4">
                        <div class="mb-3">
                            <i class="bi bi-truck fs-1 text-info"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Catálogo de Unidades</h5>
                        <p class="text-white-50 small mb-0">Gestionar los autobuses disponibles del sistema.</p>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Viaje" asp-action="Index" class="text-decoration-none">
                    <div class="glass-card p-4">
                        <div class="mb-3">
                            <i class="bi bi-calendar2-week fs-1 text-info"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Gestión de Viajes</h5>
                        <p class="text-white-50 small mb-0">Programar, iniciar y cancelar viajes del sistema.</p>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="Viaje" asp-action="Cancelados" class="text-decoration-none">
                    <div class="glass-card p-4">
                        <div class="mb-3">
                            <i class="bi bi-x-octagon fs-1 text-danger"></i>
                        </div>
                        <h5 class="fw-bold text-white mb-1">Viajes Cancelados</h5>
                        <p class="text-white-50 small mb-0">Consultar viajes cancelados y su motivo.</p>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>