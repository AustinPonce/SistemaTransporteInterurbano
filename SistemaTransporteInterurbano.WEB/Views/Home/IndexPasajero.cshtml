@{
    ViewData["Title"] = "Inicio";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>

        <a asp-controller="Autenticacion"
           asp-action="CerrarSesion"
           class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="mb-5">
            <h2 class="text-white fw-bold mb-1">
                <i class="bi bi-person-circle me-2 text-info"></i>Panel de Pasajero
            </h2>
            <p class="text-white-50">
                Selecciona una opción para continuar.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-controller="MisViajes"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="glass-card p-4">

                        <div class="mb-3">
                            <i class="bi bi-ticket-perforated fs-1 text-info"></i>
                        </div>

                        <h5 class="fw-bold text-white mb-1">
                            Mis Viajes
                        </h5>

                        <p class="text-white-50 small mb-0">
                            Consultar reservas, horarios y detalles de viaje.
                        </p>

                    </div>

                </a>
            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>