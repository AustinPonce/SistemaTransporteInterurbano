@using SistemaTransporteInterurbano.Models.Entities
@model SistemaTransporteInterurbano.Models.Entities.Viaje

@{
    ViewData["Title"] = "Detalle de mi viaje";
    Layout = null;

    var reserva = ViewBag.Reserva as Reserva;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="mb-4">
            <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            <span class="text-white fw-bold fs-4">
                <i class="bi bi-info-circle me-2 text-info"></i>Detalle de mi viaje
            </span>
        </div>

        <div class="row g-4">
            <div class="col-md-8">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-white fw-bold mb-4">
                        <i class="bi bi-signpost-2 me-2 text-info"></i>Información del viaje
                    </h5>

                    <div class="row g-3 text-white-50">
                        <div class="col-md-6">
                            <strong class="text-white">Ruta:</strong><br />
                            @Model.Ruta?.Nombre
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Estado:</strong><br />
                            <span class="badge bg-info">@Model.Estado</span>
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Origen:</strong><br />
                            @Model.Ruta?.Origen
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Destino:</strong><br />
                            @Model.Ruta?.Destino
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Unidad:</strong><br />
                            @Model.Unidad?.Placa - @Model.Unidad?.Modelo
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Chofer:</strong><br />
                            @Model.Chofer?.Nombre @Model.Chofer?.Apellidos
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Salida:</strong><br />
                            @Model.FechaSalida.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        <div class="col-md-6">
                            <strong class="text-white">Llegada estimada:</strong><br />
                            @Model.FechaLlegadaEstimada.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-white fw-bold mb-4">
                        <i class="bi bi-cash-coin me-2 text-info"></i>Resumen de pago
                    </h5>

                    <div class="text-white-50 mb-3">
                        <strong class="text-white">Número de asiento:</strong><br />
                        @reserva?.NumeroAsiento
                    </div>

                    <div class="text-white-50 mb-3">
                        <strong class="text-white">Precio base:</strong><br />
                        ₡@Model.Ruta?.PrecioBase.ToString("N2")
                    </div>

                    <div class="text-white-50 mb-3">
                        <strong class="text-white">Monto total abonado:</strong><br />
                        <span class="fs-5 text-white fw-bold">
                            ₡@reserva?.MontoPagado.ToString("N2")
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
