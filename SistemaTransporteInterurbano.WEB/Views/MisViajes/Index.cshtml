@model List<SistemaTransporteInterurbano.Models.Entities.Reserva>

@{
    ViewData["Title"] = "Mis Viajes";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                    <i class="bi bi-arrow-left me-1"></i>Inicio
                </a>
                <span class="text-white fw-bold fs-4">
                    <i class="bi bi-ticket-perforated me-2 text-info"></i>Mis Viajes
                </span>
            </div>
        </div>

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="glass-card p-0 overflow-hidden">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-ticket-perforated fs-1 d-block mb-2"></i>
                    No tienes reservas registradas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-glass mb-0">
                        <thead>
                            <tr>
                                <th>Estado del viaje</th>
                                <th>Ruta</th>
                                <th>Número de asiento</th>
                                <th>Fecha y hora de salida</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reserva in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-info">
                                            @reserva.Viaje?.Estado
                                        </span>
                                    </td>
                                    <td>@reserva.Viaje?.Ruta?.Nombre</td>
                                    <td>@reserva.NumeroAsiento</td>
                                    <td>@reserva.Viaje?.FechaSalida.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a asp-action="Detalle" asp-route-id="@reserva.ViajeId"
                                           class="btn btn-sm btn-outline-info rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i>Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
