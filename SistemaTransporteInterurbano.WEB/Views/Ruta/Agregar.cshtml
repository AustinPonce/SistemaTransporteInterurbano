@model SistemaTransporteInterurbano.WEB.Models.ViewModels.AgregarRutaViewModel

@{
    ViewData["Title"] = "Agregar Ruta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="d-flex align-items-center mb-4 gap-3">
                    <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <h2 class="fw-bold text-white mb-0">
                        <i class="bi bi-signpost-2 me-2 text-info"></i>Agregar Ruta
                    </h2>
                </div>

                @if (ViewBag.MensajeError != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.MensajeError
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="glass-card p-4">
                    <form asp-action="Agregar" method="post" autocomplete="off">

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre de la ruta" />
                            </div>
                            <span asp-validation-for="Nombre" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Origen" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Origen" class="form-control" placeholder="Ciudad de origen" />
                            </div>
                            <span asp-validation-for="Origen" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Destino" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-geo-fill"></i></span>
                                <input asp-for="Destino" class="form-control" placeholder="Ciudad de destino" />
                            </div>
                            <span asp-validation-for="Destino" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DuracionEstimada" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                <input asp-for="DuracionEstimada" class="form-control" placeholder="Ej: 02:30" />
                            </div>
                            <span asp-validation-for="DuracionEstimada" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PrecioBase" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                                <input asp-for="PrecioBase" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PrecioBase" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-gradient-save btn-lg fs-6">
                                <i class="bi bi-check2-circle me-2"></i>Registrar Ruta
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>