@model List<SistemaTransporteInterurbano.Models.Entities.Ruta>

@{
    ViewData["Title"] = "Catálogo de Rutas";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                    <i class="bi bi-arrow-left me-1"></i>Inicio
                </a>
                <span class="text-white fw-bold fs-4">
                    <i class="bi bi-signpost-2 me-2 text-info"></i>Catálogo de Rutas
                </span>
            </div>
            <a asp-action="Agregar" class="btn btn-gradient-add">
                <i class="bi bi-plus-circle me-1"></i>Agregar Ruta
            </a>
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 bg-success text-white mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="glass-card p-4 mb-4">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <div class="input-group glass-input-group flex-grow-1">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="filtro" class="form-control"
                           placeholder="Buscar por nombre o destino..."
                           value="@ViewBag.Filtro" />
                </div>
                <button type="submit" class="btn btn-gradient-search px-4">Buscar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Filtro as string))
                {
                    <a asp-action="Index" class="btn btn-outline-light px-3 rounded-pill">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </form>
        </div>

        <div class="glass-card p-0 overflow-hidden">
            @if (!Model.Any())
            {
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-signpost-2 fs-1 d-block mb-2"></i>
                    No hay rutas registradas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-glass mb-0">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Origen</th>
                                <th>Destino</th>
                                <th>Duración</th>
                                <th>Precio base</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ruta in Model)
                            {
                                <tr>
                                    <td>@ruta.Nombre</td>
                                    <td>@ruta.Origen</td>
                                    <td>@ruta.Destino</td>
                                    <td>@ruta.DuracionEstimada.ToString(@"hh\:mm")</td>
                                    <td>₡@ruta.PrecioBase.ToString("N2")</td>
                                    <td class="text-end">
                                        <a asp-action="Editar" asp-route-id="@ruta.RutaId"
                                           class="btn btn-sm btn-outline-info rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i>Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>