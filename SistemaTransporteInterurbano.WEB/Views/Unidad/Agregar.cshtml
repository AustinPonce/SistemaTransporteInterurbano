@model SistemaTransporteInterurbano.WEB.Models.ViewModels.AgregarUnidadViewModel

@{
    ViewData["Title"] = "Agregar Unidad";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="d-flex align-items-center mb-4 gap-3">
                    <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <h2 class="fw-bold text-white mb-0">
                        <i class="bi bi-bus-front me-2 text-info"></i>Agregar Unidad
                    </h2>
                </div>

                @if (ViewBag.MensajeError != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.MensajeError
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="glass-card p-4">
                    <form asp-action="Agregar" method="post" autocomplete="off">

                        <div class="mb-3">
                            <label asp-for="Placa" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                <input asp-for="Placa" class="form-control" placeholder="Ej: ABC123" />
                            </div>
                            <span asp-validation-for="Placa" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Modelo" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-bus-front"></i></span>
                                <select asp-for="Modelo" class="form-select glass-input-group-select">
                                    <option value="">Seleccione un modelo</option>
                                    @{
                                        var modelos = ViewBag.Modelos as List<string> ?? new List<string>();
                                        foreach (var m in modelos)
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="Modelo" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AnioFabricacion" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                                <input asp-for="AnioFabricacion" type="number" min="0" class="form-control" placeholder="Ej: 2020" />
                            </div>
                            <span asp-validation-for="AnioFabricacion" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CapacidadPasajeros" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-people"></i></span>
                                <input asp-for="CapacidadPasajeros" type="number" min="1" class="form-control" placeholder="Ej: 45" />
                            </div>
                            <span asp-validation-for="CapacidadPasajeros" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-gradient-save btn-lg fs-6">
                                <i class="bi bi-check2-circle me-2"></i>Registrar Unidad
                            </button>
                        </div>

                    </form>
                </div>

                @if (ViewBag.UnidadesPredeterminadas != null)
                {
                    var unidades = ViewBag.UnidadesPredeterminadas as List<Dictionary<string, string>>;
                    if (unidades != null && unidades.Any())
                    {
                        <div class="glass-card p-4 mt-4">
                            <h5 class="text-white fw-bold mb-3">
                                <i class="bi bi-bookmark-check me-2 text-info"></i>Unidades predeterminadas
                            </h5>
                            <p class="text-white-50 small mb-3">Seleccione una unidad para precargar sus datos:</p>
                            <div class="table-responsive">
                                <table class="table table-glass mb-0">
                                    <thead>
                                        <tr>
                                            <th>Placa</th>
                                            <th>Modelo</th>
                                            <th>Año</th>
                                            <th>Capacidad</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in unidades)
                                        {
                                            <tr class="unidad-predeterminada" role="button"
                                                data-placa="@u["Placa"]"
                                                data-modelo="@u["Modelo"]"
                                                data-anio="@u["Anio"]"
                                                data-capacidad="@u["Capacidad"]"
                                                onclick="cargarUnidad(this)">
                                                <td>@u["Placa"]</td>
                                                <td>@u["Modelo"]</td>
                                                <td>@u["Anio"]</td>
                                                <td>@u["Capacidad"]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function cargarUnidad(el) {
            document.getElementById('Placa').value = el.dataset.placa;
            document.getElementById('Modelo').value = el.dataset.modelo;
            document.getElementById('AnioFabricacion').value = el.dataset.anio;
            document.getElementById('CapacidadPasajeros').value = el.dataset.capacidad;
        }
    </script>
</body>
</html>
