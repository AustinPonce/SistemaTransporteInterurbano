@using SistemaTransporteInterurbano.Models.Entities
@model List<SistemaTransporteInterurbano.Models.Entities.Viaje>

@{
    ViewData["Title"] = "Gestión de Viajes";
    Layout = null;

    string EstadoBadge(EstadoViaje e) => e switch
    {
        EstadoViaje.Programado => "bg-info",
        EstadoViaje.EnCurso => "bg-success",
        EstadoViaje.Completado => "bg-primary",
        EstadoViaje.Cancelado => "bg-danger",
        _ => "bg-secondary"
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                    <i class="bi bi-arrow-left me-1"></i>Inicio
                </a>
                <span class="text-white fw-bold fs-4">
                    <i class="bi bi-calendar2-week me-2 text-info"></i>Gestión de Viajes
                </span>
            </div>
            <a asp-action="Agregar" class="btn btn-gradient-add">
                <i class="bi bi-plus-circle me-1"></i>Agregar Viaje
            </a>
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 bg-success text-white mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="glass-card p-4 mb-4">
            <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1">
                    <label class="form-label small fw-semibold text-white-50 ms-1 mb-1">Filtrar por ruta</label>
                    <div class="input-group glass-input-group">
                        <span class="input-group-text"><i class="bi bi-signpost-2"></i></span>
                        <input type="text" name="filtroRuta" class="form-control"
                               placeholder="Nombre de la ruta..."
                               value="@ViewBag.FiltroRuta" />
                    </div>
                </div>
                <div>
                    <label class="form-label small fw-semibold text-white-50 ms-1 mb-1">Filtrar por fecha</label>
                    <div class="input-group glass-input-group">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                        <input type="date" name="filtroFecha" class="form-control"
                               value="@ViewBag.FiltroFecha" />
                    </div>
                </div>
                <button type="submit" class="btn btn-gradient-search px-4">Buscar</button>
                @if (!string.IsNullOrEmpty(ViewBag.FiltroRuta as string) || !string.IsNullOrEmpty(ViewBag.FiltroFecha as string))
                {
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </form>
        </div>

        <div class="glass-card p-0 overflow-hidden">
            @if (!Model.Any())
            {
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-calendar2-x fs-1 d-block mb-2"></i>
                    No hay viajes registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-glass mb-0">
                        <thead>
                            <tr>
                                <th>Nº Viaje</th>
                                <th>Ruta</th>
                                <th>Placa</th>
                                <th>Chofer</th>
                                <th>Fecha y hora de salida</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>#@v.ViajeId</td>
                                    <td>@v.Ruta?.Nombre</td>
                                    <td>@v.Unidad?.Placa</td>
                                    <td>@v.Chofer?.Nombre @v.Chofer?.Apellidos</td>
                                    <td>@v.FechaSalida.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge @EstadoBadge(v.Estado)">@v.Estado</span></td>
                                    <td class="text-end">

                                        @if (v.Estado == EstadoViaje.Programado)
                                        {
                                            <a asp-action="Editar"
                                               asp-route-id="@v.ViajeId"
                                               class="btn btn-sm btn-outline-info rounded-pill px-3 me-1">
                                                <i class="bi bi-pencil me-1"></i>Editar
                                            </a>

                                            <form asp-action="Iniciar"
                                                  asp-route-id="@v.ViajeId"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success rounded-pill px-3 me-1"
                                                        onclick="return confirm('¿Iniciar este viaje?');">
                                                    <i class="bi bi-play-fill me-1"></i>Iniciar
                                                </button>
                                            </form>

                                            <a asp-action="Cancelar"
                                               asp-route-id="@v.ViajeId"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-x-circle me-1"></i>Cancelar
                                            </a>
                                        }
                                        else if (v.Estado == EstadoViaje.EnCurso)
                                        {
                                            <a asp-action="Reservar"
                                               asp-route-id="@v.ViajeId"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                                <i class="bi bi-ticket-perforated me-1"></i>Reservar
                                            </a>

                                            <a asp-action="Pasajeros"
                                               asp-route-id="@v.ViajeId"
                                               class="btn btn-sm btn-outline-info rounded-pill px-3 me-1">
                                                <i class="bi bi-people me-1"></i>Pasajeros
                                            </a>

                                            <form asp-action="Finalizar"
                                                  asp-route-id="@v.ViajeId"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success rounded-pill px-3"
                                                        onclick="return confirm('¿Finalizar este viaje?');">
                                                    <i class="bi bi-check-circle me-1"></i>Finalizar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-white-50 small">Sin acciones</span>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
