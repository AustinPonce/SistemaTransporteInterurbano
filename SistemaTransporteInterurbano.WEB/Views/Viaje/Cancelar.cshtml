@model SistemaTransporteInterurbano.WEB.Models.ViewModels.CancelarViajeViewModel

@{
    ViewData["Title"] = "Cancelar Viaje";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="d-flex align-items-center mb-4 gap-3">
                    <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <h2 class="fw-bold text-white mb-0">
                        <i class="bi bi-x-octagon me-2 text-danger"></i>Cancelar Viaje
                    </h2>
                </div>

                @if (ViewBag.MensajeError != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.MensajeError
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="glass-card p-4">

                    <div class="alert alert-warning border-0 rounded-4 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Está a punto de cancelar el viaje <strong>#@Model.ViajeId</strong>.
                        Se notificará por correo a todos los pasajeros con reserva activa.
                    </div>

                    <ul class="list-unstyled text-white-50 small mb-4">
                        <li><strong class="text-white">Ruta:</strong> @Model.RutaNombre</li>
                        <li><strong class="text-white">Placa:</strong> @Model.PlacaUnidad</li>
                        <li><strong class="text-white">Salida:</strong> @Model.FechaSalida.ToString("dd/MM/yyyy HH:mm")</li>
                    </ul>

                    <form asp-action="Cancelar" method="post" autocomplete="off">

                        <input asp-for="ViajeId" type="hidden" />
                        <input asp-for="RutaNombre" type="hidden" />
                        <input asp-for="PlacaUnidad" type="hidden" />
                        <input asp-for="FechaSalida" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="Motivo" class="form-label small fw-semibold text-white-50 ms-1 mb-1"></label>
                            <div class="input-group glass-input-group">
                                <span class="input-group-text"><i class="bi bi-chat-left-text"></i></span>
                                <textarea asp-for="Motivo" class="form-control" rows="4"
                                          placeholder="Indique el motivo de la cancelación..."></textarea>
                            </div>
                            <span asp-validation-for="Motivo" class="text-info small ms-2 d-block mt-1"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fs-6"
                                    onclick="return confirm('¿Confirma la cancelación del viaje? Esta acción no se puede deshacer.');">
                                <i class="bi bi-x-circle me-2"></i>Confirmar Cancelación
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light">Volver sin cancelar</a>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
