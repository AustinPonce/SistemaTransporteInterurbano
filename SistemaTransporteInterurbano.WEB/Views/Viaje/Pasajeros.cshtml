@model List<SistemaTransporteInterurbano.Models.Entities.Reserva>

@{
    ViewData["Title"] = "Pasajeros del Viaje";
    Layout = null;

    var viaje = ViewBag.Viaje as SistemaTransporteInterurbano.Models.Entities.Viaje;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>

        <a asp-controller="Autenticacion"
           asp-action="CerrarSesion"
           class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <a asp-action="EnCurso"
                   class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>

                <span class="text-white fw-bold fs-4">
                    <i class="bi bi-people me-2 text-info"></i>Pasajeros del Viaje
                </span>
            </div>

            <form asp-action="Finalizar" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@viaje?.ViajeId" />

                <button type="submit"
                        class="btn btn-danger rounded-pill">
                    <i class="bi bi-flag-fill me-1"></i>Finalizar Viaje
                </button>
            </form>

        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 bg-success text-white mb-4">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4 mb-4">

            <div class="col-md-4">
                <div class="glass-card p-4 text-center">
                    <h6 class="text-white-50">Pasajeros</h6>
                    <h2 class="text-white">@ViewBag.Pasajeros</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="glass-card p-4 text-center">
                    <h6 class="text-white-50">Disponibles</h6>
                    <h2 class="text-white">@ViewBag.Disponibles</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="glass-card p-4 text-center">
                    <h6 class="text-white-50">Recaudación</h6>
                    <h2 class="text-white">
                        ₡@(((decimal)ViewBag.Total).ToString("N2"))
                    </h2>
                </div>
            </div>

        </div>

        <div class="glass-card p-0 overflow-hidden">

            @if (!Model.Any())
            {
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                    No hay pasajeros registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-glass mb-0">

                        <thead>
                            <tr>
                                <th>Pasajero</th>
                                <th>Identificación</th>
                                <th>Asiento</th>
                                <th>Monto Pagado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var reserva in Model)
                            {
                                <tr>

                                    <td>
                                        @reserva.Pasajero.Nombre
                                        @reserva.Pasajero.Apellidos
                                    </td>

                                    <td>
                                        @reserva.Pasajero.Identificacion
                                    </td>

                                    <td>
                                        @reserva.NumeroAsiento
                                    </td>

                                    <td>
                                        ₡@reserva.MontoPagado.ToString("N2")
                                    </td>

                                    <td class="text-end">

                                        <form asp-action="CancelarReserva"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="reservaId"
                                                   value="@reserva.ReservaId" />

                                            <input type="hidden"
                                                   name="viajeId"
                                                   value="@viaje?.ViajeId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="bi bi-trash me-1"></i>Cancelar
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                </div>
            }

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
