@model List<SistemaTransporteInterurbano.Models.Entities.Viaje>

@{
    ViewData["Title"] = "Viajes Cancelados";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                    <i class="bi bi-arrow-left me-1"></i>Inicio
                </a>
                <span class="text-white fw-bold fs-4">
                    <i class="bi bi-x-octagon me-2 text-danger"></i>Viajes Cancelados
                </span>
            </div>
        </div>

        <div class="glass-card p-0 overflow-hidden">
            @if (!Model.Any())
            {
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-emoji-smile fs-1 d-block mb-2"></i>
                    No hay viajes cancelados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-glass mb-0">
                        <thead>
                            <tr>
                                <th>Nº Viaje</th>
                                <th>Ruta</th>
                                <th>Placa</th>
                                <th>Chofer</th>
                                <th>Fecha y hora de salida</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>#@v.ViajeId</td>
                                    <td>@v.Ruta?.Nombre</td>
                                    <td>@v.Unidad?.Placa</td>
                                    <td>@v.Chofer?.Nombre @v.Chofer?.Apellidos</td>
                                    <td>@v.FechaSalida.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a asp-action="DetalleCancelado" asp-route-id="@v.ViajeId"
                                           class="btn btn-sm btn-outline-info rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i>Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
