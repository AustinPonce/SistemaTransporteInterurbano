@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Reservar Asiento";
    Layout = null;

    var viaje = ViewBag.Viaje as SistemaTransporteInterurbano.Models.Entities.Viaje;
    var pasajeros = ViewBag.Pasajeros as List<SelectListItem>;
    int capacidad = ViewBag.Capacidad ?? 0;
    var ocupados = ViewBag.AsientosOcupados as List<int> ?? new List<int>();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Transporte Interurbano</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/glass.css" />
</head>
<body>

    <nav class="navbar glass-nav px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">
            <i class="bi bi-bus-front me-2 text-info"></i>Sistema de Transporte Interurbano
        </span>
        <a asp-controller="Autenticacion" asp-action="CerrarSesion" class="btn btn-cerrar btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
        </a>
    </nav>

    <div class="container py-5">

        <div class="mb-4">
            <a asp-action="EnCurso" class="btn btn-outline-light btn-sm rounded-pill px-3 me-3">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>

            <span class="text-white fw-bold fs-4">
                <i class="bi bi-ticket-perforated me-2 text-info"></i>Reservar Asiento
            </span>
        </div>

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 bg-danger text-white mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="glass-card p-4">

            <div class="mb-4 text-white">
                <h5>
                    <i class="bi bi-signpost-2 me-2 text-info"></i>
                    @viaje?.Ruta?.Nombre
                </h5>

                <div class="text-white-50">
                    Salida: @viaje?.FechaSalida.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="text-white-50">
                    Unidad: @viaje?.Unidad?.Placa
                </div>

                <div class="text-white-50">
                    Capacidad: @capacidad asientos
                </div>
            </div>

            <form asp-action="Reservar" method="post" id="formReserva">
                @Html.AntiForgeryToken()

                <input type="hidden" name="viajeId" value="@viaje?.ViajeId" />
                <input type="hidden" name="numeroAsiento" id="numeroAsiento" required />

                <div class="mb-4">
                    <label class="form-label text-white">Pasajero</label>

                    <select name="pasajeroId" class="form-select" required>
                        <option value="">Seleccione...</option>

                        @foreach (var pasajero in pasajeros ?? new())
                        {
                            <option value="@pasajero.Value">
                                @pasajero.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label text-white">Seleccione un asiento</label>

                    <div class="mb-3">
                        <span class="badge bg-success me-2">Disponible</span>
                        <span class="badge bg-danger me-2">Reservado</span>
                        <span class="badge bg-warning text-dark">Seleccionado</span>
                    </div>

                    <div class="row g-2 mb-4">
                        @for (int i = 1; i <= capacidad; i++)
                        {
                            bool reservado = ocupados.Contains(i);

                            <div class="col-2 col-sm-1">
                                <button type="button"
                                        class="btn w-100 @(reservado ? "btn-danger" : "btn-success asiento-disponible")"
                                        data-asiento="@i"
                                    @(reservado ? "disabled" : "")>
                                    @i
                                </button>
                            </div>
                        }
                    </div>

                    <div class="text-white-50">
                        Asiento seleccionado:
                        <span id="asientoSeleccionado" class="text-white fw-bold">Ninguno</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-gradient-add">
                    <i class="bi bi-check-circle me-1"></i>
                    Registrar Reserva
                </button>
            </form>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.querySelectorAll('.asiento-disponible').forEach(function (btn) {
        btn.addEventListener('click', function () {
        const asiento = this.dataset.asiento;

        document.getElementById('numeroAsiento').value = asiento;
        document.getElementById('asientoSeleccionado').innerText = asiento;

        document.querySelectorAll('.asiento-disponible').forEach(function (b) {
        b.classList.remove('btn-warning');
        b.classList.add('btn-success');
        });

        this.classList.remove('btn-success');
        this.classList.add('btn-warning');
        });
        });

        document.getElementById('formReserva').addEventListener('submit', function (event) {
        const asiento = document.getElementById('numeroAsiento').value;

        if (!asiento) {
        event.preventDefault();
        alert('Debe seleccionar un asiento antes de registrar la reserva.');
        }
        });
    </script>

</body>
</html>